configuration {
    kb-accept-custom: "";
    kb-accept-custom-alt: "";
    kb-accept-alt: "";
}

* {
    font: "sans-serif 14";
    background: #151922;
    background-color: @background;
    background-alt: #202633;
    foreground: #f0f0f0;
    foreground-muted: #9aa5b5;
    selected: #283142;
    border: #2b3342;
}

window {
    width: 38%;
    location: center;
    anchor: center;
    background-color: @background;
    border: 1px;
    border-color: @border;
    border-radius: 8px;
}

mainbox {
    padding: 10px;
}

inputbar {
    padding: 8px;
    background-color: @background-alt;
    border-radius: 6px;
}

prompt {
    text-color: @foreground-muted;
}

entry {
    text-color: @foreground;
}

listview {
    lines: 12;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 10px 12px;
    border-radius: 6px;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
