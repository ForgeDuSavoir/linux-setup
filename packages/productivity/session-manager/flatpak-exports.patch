+/// Flatpak exports use file links into app/<ID>/<arch>/<branch>/<deployment>/export.
+/// Only these installed exports may follow links; arbitrary XDG and local links
+/// remain excluded. Canonicalize once, then use no-follow directory-relative IO.
+fn flatpak_export_target(location: &Path, name: &Path) -> Result<Option<PathBuf>> {
+    if !location.ends_with("exports/share/applications") {
+        return Ok(None);
+    }
+    let Some(base) = location
+        .parent()
+        .and_then(Path::parent)
+        .and_then(Path::parent)
+    else {
+        return Ok(None);
+    };
+    let target = match fs::canonicalize(location.join(name)) {
+        Ok(target) => target,
+        Err(error)
+            if matches!(
+                error.raw_os_error(),
+                Some(nix::libc::ENOENT | nix::libc::ELOOP | nix::libc::ENOTDIR)
+            ) =>
+        {
+            return Ok(None);
+        }
+        Err(_) => return Err(Error("filesystem.unavailable")),
+    };
+    let Ok(relative) = target.strip_prefix(base.join("app")) else {
+        return Ok(None);
+    };
+    let parts: Vec<_> = relative.components().collect();
+    let id = name.to_str().and_then(|text| text.strip_suffix(".desktop"));
+    if parts.len() != 8
+        || parts[0].as_os_str().to_str() != id
+        || Path::new(
+            &parts[4..]
+                .iter()
+                .map(|part| part.as_os_str())
+                .collect::<PathBuf>(),
+        ) != Path::new("export/share/applications").join(name)
+    {
+        return Ok(None);
+    }
+    let metadata = fs::symlink_metadata(&target)?;
+    if !metadata.is_file() {
+        return Ok(None);
+    }
+    Ok(Some(target))
+}
