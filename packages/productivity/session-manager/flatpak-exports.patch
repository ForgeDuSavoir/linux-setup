+#[test]
+fn flatpak_exports_resolve_bounded_targets_and_preserve_xdg_priority() {
+    let f = Fixture::new();
+    let base = f.root.as_ref().unwrap().root().join("flatpak");
+    let exports = base.join("exports/share/applications");
+    let deployment = base.join("app/com.todoist.Todoist/x86_64/stable/deployment");
+    let app_dir = deployment.join("export/share/applications");
+    fs::create_dir_all(&exports).unwrap();
+    fs::create_dir_all(&app_dir).unwrap();
+    let id = "com.todoist.Todoist.desktop";
+    fs::write(app_dir.join(id), entry("Todoist", "")).unwrap();
+    symlink("deployment", deployment.parent().unwrap().join("active")).unwrap();
+    symlink("../../../app/com.todoist.Todoist/x86_64/stable/active/export/share/applications/com.todoist.Todoist.desktop", exports.join(id)).unwrap();
+    let environment = ApplicationEnvironment::from_values(
+        &f.root.as_ref().unwrap().home(),
+        Some(f.data[0].to_str().unwrap()),
+        Some(base.join("exports/share").to_str().unwrap()),
+        Some("KDE"),
+        Some(""),
+    )
+    .unwrap();
+    let resolver = ApplicationResolver::new(environment);
+    let apps = resolver.installed().unwrap().applications;
+    assert_eq!(apps.len(), 1);
+    assert_eq!(apps[0].name, "Todoist");
+    f.installed(0, id, "Hidden", "Hidden=true\n");
+    assert!(resolver.installed().unwrap().applications.is_empty());
+    fs::remove_file(f.data[0].join("applications").join(id)).unwrap();
+    fs::write(app_dir.join(id), entry("Todoist", "Hidden=true\n")).unwrap();
+    assert!(resolver.installed().unwrap().applications.is_empty());
+    fs::write(app_dir.join(id), "invalid").unwrap();
+    code(resolver.installed(), "application.invalid_installed_file");
+    fs::remove_file(exports.join(id)).unwrap();
+    symlink(f.data[0].join("outside.desktop"), exports.join(id)).unwrap();
+    assert!(resolver.installed().unwrap().applications.is_empty());
+    fs::remove_file(exports.join(id)).unwrap();
+    symlink(&f.source, exports.join(id)).unwrap();
+    assert!(resolver.installed().unwrap().applications.is_empty());
+}
